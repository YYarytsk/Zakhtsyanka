# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never expose to client

# ── WayForPay ─────────────────────────────────────────────────────────────────
# Get these from https://secure.wayforpay.com/partner → My Accounts → Edit
# Merchant account name (not a secret, used in payment form)
NEXT_PUBLIC_WFP_MERCHANT_ACCOUNT=your_merchant_account
# Secret key — server-side only, never expose to client
WFP_MERCHANT_SECRET_KEY=your_merchant_secret_key
# Domain registered with WayForPay (must match exactly)
NEXT_PUBLIC_WFP_MERCHANT_DOMAIN=yourdomain.com

# ── Store identity (configurable — no redeploy needed after DB is seeded) ────
# These are the fallback values used before store_settings is seeded in the DB.
# After seeding, the DB values take precedence.
NEXT_PUBLIC_STORE_NAME_UK="Захцянка"
NEXT_PUBLIC_STORE_NAME_EN="Zakhtsyanka"
NEXT_PUBLIC_DEFAULT_LOCALE=uk                     # uk | en

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...                             # https://resend.com
NOTIFICATION_FROM_EMAIL=noreply@yourdomain.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+380...                        # Ukrainian number (+380...)

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Subscription billing cron ─────────────────────────────────────────────────
# Set this secret and call POST /api/cron/billing with Authorization: Bearer <secret>
# Schedule via Azure Container Apps Job or any cron service — run daily at 06:00 UA time
CRON_SECRET=your-long-random-secret
